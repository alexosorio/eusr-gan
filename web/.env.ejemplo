# Copie este archivo como .env y ajuste los valores.

# Acceso con usuario y clave (recomendado si el servidor es público)
APP_USUARIO=medico
APP_CLAVE=cambie-esta-clave

# Rutas de los pesos dentro del contenedor (por defecto, carpeta pesos/)
# MODELO_MAMA=pesos/eusr_busi.weights.h5
# MODELO_CORAZON=pesos/eusr_camus.weights.h5

# Límites
# MAX_LADO_AMPLIAR=512   # lado máximo de la zona en modo "Ampliar ×4"
# MAX_MB=25              # tamaño máximo del archivo subido
# LOTE=16                # mosaicos por lote; bájelo si el servidor tiene poca memoria

# Dominio para HTTPS (solo con: docker compose --profile https up -d)
# DOMINIO=eusr.midominio.co
